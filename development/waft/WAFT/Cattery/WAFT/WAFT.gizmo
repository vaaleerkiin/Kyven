version 16.0 v4
Gizmo {
 onCreate "import cattery_waft; cattery_waft.on_create()"
 onDestroy "nuke.thisNode()\[\"knobChanged\"].setValue(\"\")"
 knobChanged "import cattery_waft; cattery_waft.knob_changed()"
 selected true
 xpos 178
 ypos -87
 addUserKnob {20 WAFT l "Kyven WAFT"}
 addUserKnob {26 kyven_logo l "" +STARTLINE}
 addUserKnob {26 kyven_title l "" -STARTLINE T "<font size='5' color='#dce9f2'><b>KYVEN WAFT</b></font>"}
 addUserKnob {26 model_section l "" +STARTLINE T "<br><font color='#9fc7e8'><b>MODEL AND PERFORMANCE</b></font>"}
 addUserKnob {26 model_info l "Model" T "WAFT-a1 / 5 iterations / v5"}
 addUserKnob {4 precision l "Precision" t "GPU FP16 uses half precision weights and attention, with float32 flow accumulation. FP32 supports CPU. Turning off GPU automatically selects the FP32 model." M {"GPU FP16 (Fast)" "FP32 (Compatible)"}}
 addUserKnob {6 useGPUIfAvailable l "Use GPU if available" t "Select this to render on the <b>Local GPU</b>, if available.\n\nYou can select this even if no GPU is currently available on your machine. The GPU will then be used whenever the script is opened on a machine which does have a GPU available. You should also select this if you wish to render from the command line with the <b>--gpu</b> option.\n\nIf this node requires full frames from its inputs, and is therefore unable to reduce its memory overhead, it will fall back to the CPU if an attempt to render a frame on the GPU fails due to lack of memory. When this occurs, a warning message will be printed to the console." +STARTLINE}
 useGPUIfAvailable true
 addUserKnob {26 localGPU l "Local GPU:" T ""}
 addUserKnob {26 gpuName l "" -STARTLINE T ""}
 addUserKnob {4 processing l "Processing Resolution" t "Limits the longest edge used by WAFT. Output always returns to the input source format, with vector lengths scaled accordingly. Lower settings use less VRAM and can lose fine detail." M {"512 (Low VRAM)" "768 (Balanced)" "1024 (High)" "Full Source"}}
 addUserKnob {26 input_section l "" +STARTLINE T "<br><font color='#9fc7e8'><b>INPUT</b></font>"}
 addUserKnob {41 in_colorspace l "Input Colorspace" t "Define the colorspace that the input image is in." T Colorspace1.colorspace_in}
 addUserKnob {26 channelsIn l "Channels In:" t "The channels the model expects as input." T "rgba.red, rgba.green, rgba.blue"}
 addUserKnob {26 output_section l "" +STARTLINE T "<br><font color='#9fc7e8'><b>OUTPUT</b></font>"}
 addUserKnob {4 output_mode l "Output Mode" t "Motion Vectors: native Nuke motion channels via VectorToMotion. Smart Vectors: the same smartvector layer as RAFT Cattery." M {"Motion Vectors" "Smart Vectors"}}
 addUserKnob {26 cleanup_section l "" +STARTLINE T "<br><font color='#9fc7e8'><b>VECTOR CLEANUP</b></font>"}
 addUserKnob {7 grid_cleanup l "Grid Suppression" t "Edge-aware smoothing of fine grid/ripple in the vector field before resizing. 0 preserves the raw model output, 1 applies full cleanup. May remove small real motion variations." R 0 1}
 grid_cleanup 1
 addUserKnob {7 cleanup_range l "Edge Threshold" t "Vector difference, in working-resolution pixels, over which smoothing is reduced. Lower values preserve smaller motion boundaries; higher values suppress stronger ripple." R 0.01 2}
 cleanup_range 0.25
}
 Input {
  inputs 0
  name Input1
  xpos 829
  ypos -13
 }
set Nb9c4000 [stack 0]
 Dot {
  name Dot10
  xpos 1346
  ypos -10
 }
 Assert {
  expression 0
  message "The input stream is missing rgb"
  name Assert1
  xpos 1312
  ypos 396
 }
push $Nb9c4000
 Colorspace {
  colorspace_out sRGB
  name Colorspace1
  xpos 829
  ypos 41
 }
 Crop {
  box {0 0 {input.width} {input.height}}
  reformat false
  name SourceBounds
 }
 Reformat {
  type "to box"
  box_width {{max(1,floor(input.width*(parent.processing==3?1:min(1,(parent.processing==0?512:parent.processing==1?768:1024)/max(input.width,input.height)))))}}
  box_height {{max(1,floor(input.height*(parent.processing==3?1:min(1,(parent.processing==0?512:parent.processing==1?768:1024)/max(input.width,input.height)))))}}
  box_fixed true
  resize distort
  filter Lanczos4
  black_outside false
  name WorkingResolution
 }
 Dot {
  name Dot9
  xpos 863
  ypos 92
 }
set Nb9c5000 [stack 0]
 Dot {
  name Dot4
  xpos 1103
  ypos 92
 }
 Dot {
  name Dot6
  xpos 1103
  ypos 157
 }
set Nb9c5800 [stack 0]
push $Nb9c5800
 Dot {
  name Dot7
  xpos 1191
  ypos 157
 }
 TimeOffset {
  time_offset -1
  time ""
  name TimeOffset2
  xpos 1157
  ypos 198
 }
 Dot {
  name Dot8
  xpos 1191
  ypos 241
 }
 Shuffle2 {
  inputs 2
  fromInput1 {{1} B A}
  fromInput2 {{0} B A}
  in2 rgb
  out2 motion
  mappings "8 rgba.red 0 0 rgba.red 0 0 rgba.green 0 1 rgba.green 0 1 rgba.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3 black -1 -1 backward.v 1 3 rgba.red 1 0 forward.u 1 0 rgba.green 1 1 forward.v 1 1 rgba.blue 1 2 backward.u 1 2"
  name Shuffle12
  xpos 1069
  ypos 237
 }
 Inference {
  useGPUIfAvailable {{parent.useGPUIfAvailable}}
  modelFile "\[lsearch -inline \[plugins -all WAFT.cat] *.cat]"
  halfPrecision false
  name Inference2
  xpos 1069
  ypos 287
 }
 Remove {
  operation keep
  channels {rgba.red rgba.green}
  name FlowPlanes2
 }
 Bilateral {
  Size 2
  PositionalSigma 0.7
  ColorSigma {{parent.cleanup_range}}
  mix {{parent.grid_cleanup}}
  disable {{parent.grid_cleanup==0}}
  name VectorCleanup2
 }
 Dot {
  name Dot5
  xpos 1103
  ypos 336
 }
push $Nb9c5000
 Dot {
  name Dot1
  xpos 863
  ypos 144
 }
set Nb9f1000 [stack 0]
push $Nb9f1000
 Dot {
  name Dot2
  xpos 951
  ypos 144
 }
 TimeOffset {
  time_offset 1
  time ""
  name TimeOffset1
  xpos 917
  ypos 185
 }
 Dot {
  name Dot3
  xpos 951
  ypos 228
 }
 Shuffle2 {
  inputs 2
  fromInput1 {{1} B A}
  fromInput2 {{0} B A}
  in2 rgb
  out2 motion
  mappings "8 rgba.red 0 0 rgba.red 0 0 rgba.green 0 1 rgba.green 0 1 rgba.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3 black -1 -1 backward.v 1 3 rgba.red 1 0 forward.u 1 0 rgba.green 1 1 forward.v 1 1 rgba.blue 1 2 backward.u 1 2"
  name Shuffle1
  xpos 829
  ypos 224
 }
 Inference {
  useGPUIfAvailable {{parent.useGPUIfAvailable}}
  modelFile "\[lsearch -inline \[plugins -all WAFT.cat] *.cat]"
  halfPrecision false
  name Inference1
  xpos 829
  ypos 284
 }
 Remove {
  operation keep
  channels {rgba.red rgba.green}
  name FlowPlanes1
 }
 Bilateral {
  Size 2
  PositionalSigma 0.7
  ColorSigma {{parent.cleanup_range}}
  mix {{parent.grid_cleanup}}
  disable {{parent.grid_cleanup==0}}
  name VectorCleanup1
 }
 Shuffle2 {
  inputs 2
  fromInput1 {{0} B A}
  out1 motion
  fromInput2 {{1} B A}
  in2 rgba
  mappings "4 rgba.red 0 0 forward.u 0 0 rgba.green 0 1 forward.v 0 1 rgba.red 1 0 backward.u 0 2 rgba.green 1 1 backward.v 0 3"
  name Shuffle3
  xpos 829
  ypos 332
 }
 Grade {
  channels {forward.u -forward.v}
  white -1
  black_clamp false
  name Grade8
  xpos 829
  ypos 389
 }
 Grade {
  channels {backward.u -backward.v}
  white -1
  black_clamp false
  name Grade9
  xpos 829
  ypos 427
 }
 Reformat {
  type "to box"
  box_width {{parent.Input1.width}}
  box_height {{parent.Input1.height}}
  box_fixed true
  box_pixel_aspect {{parent.Input1.pixel_aspect}}
  resize distort
  filter Cubic
  black_outside false
  name SourceResolution
 }
 Multiply {
  channels {forward.u backward.u}
  value {{parent.Input1.width/parent.WorkingResolution.width}}
  name ScaleVectorX
 }
 Multiply {
  channels {forward.v backward.v}
  value {{parent.Input1.height/parent.WorkingResolution.height}}
  name ScaleVectorY
 }
set waft_vector_bounds [stack 0]
add_layer {smartvector_f01_v01 smartvector_f01_v01.n_u smartvector_f01_v01.n_v smartvector_f01_v01.p_u smartvector_f01_v01.p_v}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 motion
  out1 smartvector_f01_v01
  fromInput2 {{0} B}
  mappings "4 forward.u 0 0 smartvector_f01_v01.n_u 0 0 forward.v 0 1 smartvector_f01_v01.n_v 0 1 backward.u 0 2 smartvector_f01_v01.p_u 0 2 backward.v 0 3 smartvector_f01_v01.p_v 0 3"
  name Shuffle2
  label "\[value in] ---> \[value out]"
  xpos 829
  ypos 465
 }
 Remove {
  operation keep
  channels smartvector_f01_v01
  name Remove1
  xpos 829
  ypos 503
 }
set waft_smart [stack 0]
push $waft_smart
 VectorToMotion {
  name NativeMotion
  xpos 1040
  ypos 505
 }
 Remove {
  operation keep
  channels motion
  name MotionOnly
 }
 Switch {
  inputs 2
  which {{parent.output_mode}}
  name OutputMode
  xpos 1010
  ypos 560
 }
 Switch {
  inputs 2
  which {{"\[python \{len(nuke.toNode('Input1').channels())\}] == 0? 1:0"}}
  name Switch1
  xpos 1312
  ypos 509
 }
set waft_output [stack 0]
push $waft_vector_bounds
push $waft_output
 CopyBBox {
  inputs 2
  name OutputBounds
 }
 Output {
  name Output1
  xpos 1312
  ypos 590
 }
end_group
